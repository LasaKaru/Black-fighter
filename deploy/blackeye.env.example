# BLACKEYE game server settings. setup-server.sh copies this to /etc/blackeye.env
# (owned by root, readable by the service only). Restart after editing:
#   sudo systemctl restart blackeye

# Where Node listens. nginx in front forwards ports 80/443 to it.
PORT=8787
HOST=127.0.0.1

# Shown in the admin panel and in /health (useful when you run several regions).
REGION=asia

# Leaderboards, cloud saves and the ban list live here. Back this folder up.
DATA_DIR=/opt/blackeye/data

# Password for https://your-domain/admin. Long and random: openssl rand -hex 24
ADMIN_TOKEN=change-me

# 1 = trust X-Forwarded-For from nginx (needed for correct player IPs and bans).
TRUST_PROXY=1

# Capacity limits for one server.
MAX_CLIENTS=1000
MAX_ROOMS=300
MAX_CONN_PER_IP=6

# Message shown in chat to everyone who joins (can also be set in the admin panel).
MOTD=Welcome to Ink City!

# Region list / main data server for the WEB build go in /opt/blackeye/web.env
# (read by deploy/update.sh at build time), for example:
#   VITE_SERVERS=Asia=https://asia.example.com,EU=https://eu.example.com
#   VITE_API_URL=https://asia.example.com
